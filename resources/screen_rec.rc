1 ICON "resources\\ScreenRec.ico"

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ScreenRec"
            VALUE "FileDescription", "ScreenRec - Fast screen recorder"
            VALUE "FileVersion", "0.2.0"
            VALUE "InternalName", "screen_rec"
            VALUE "OriginalFilename", "ScreenRec.exe"
            VALUE "ProductName", "ScreenRec"
            VALUE "ProductVersion", "0.2.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 ScreenRec"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
